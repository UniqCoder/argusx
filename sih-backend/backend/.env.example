# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=unigraph
POSTGRES_USER=unigraph
POSTGRES_PASSWORD=changeme_in_prod

# Constructed from the above — set in config.py
DATABASE_URL=postgresql+asyncpg://unigraph:changeme_in_prod@postgres:5432/unigraph

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_in_prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_random_secret_never_commit_the_real_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── VASP API keys (comma-separated) ──────────────────────────────────────────
# Each VASP that calls /check-wallet gets its own key — never share across VASPs
VASP_API_KEYS=replace_with_vasp_api_key_1,replace_with_vasp_api_key_2

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Blockchain explorer API keys (Phase 3) ────────────────────────────────────
# Do not commit real values — use environment injection on the demo box
ETHERSCAN_API_KEY=replace_with_etherscan_key
BLOCKSTREAM_BASE_URL=https://blockstream.info/api
TRONGRID_API_KEY=replace_with_trongrid_key
TRONSCAN_API_KEY=replace_with_tronscan_key

# ── Ollama (Phase 6 stretch) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
