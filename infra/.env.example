# ── Infra environment for docker-compose (infra/docker-compose.yml) ─────────
# Copy this file to infra/.env and fill in values. docker-compose reads
# infra/.env automatically for ${VAR:-default} substitutions. Never commit
# infra/.env (the repo .gitignore already excludes *.env).
#
# All values below are OPTIONAL. Empty (default) is safe for every key:
# the system runs fully keyless and degrades source/rate-limit coverage only.

# ── OSINT: Bitcoin Abuse Database (chainabuse/bitcoinabuse) ─────────────────
# Free-tier API key from https://www.bitcoinabuse.com (Settings -> API).
# Enables the Bitcoin Abuse OSINT source in /risk (30 req/min rate limit).
# ransomwhe.re needs no key. Get a key at:
#   https://www.bitcoinabuse.com -> Register -> Settings -> API -> Create token
BITCOINABUSE_API_KEY=

# ── Optional. NOT required today ─────────────────────────────────────────────
# Etherscan is unused: the ETH explorer reads keyless Blockscout
# (eth.blockscout.com/api/v2). Left as a slot for future use.
ETHERSCAN_API_KEY=
# TronGrid is unused: the TRON explorer reads the Tronscan API directly.
# Leave empty unless you add a TronGrid-backed path.
TRONGRID_API_KEY=
# Tronscan API key is accepted but optional (keyless requests still work).
TRONSCAN_API_KEY=